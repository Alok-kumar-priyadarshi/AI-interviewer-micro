# gateway-service - single public entry point (local port 4000)
NODE_ENV=development
PORT=4000

# Where each internal service runs (local ports; on Vercel use https://mi-<name>.vercel.app)
AUTH_SERVICE_URL=http://localhost:4001
RESUME_SERVICE_URL=http://localhost:4002
INTERVIEW_SERVICE_URL=http://localhost:4003
SPEECH_SERVICE_URL=http://localhost:4004
REPORT_SERVICE_URL=http://localhost:4005

# Must equal JWT_ACCESS_SECRET in auth-service. 32+ random characters.
JWT_ACCESS_SECRET=replace-with-48-random-bytes-base64url
# Same value in all 7 backend services. 32+ random characters.
INTERNAL_API_KEY=replace-with-48-random-bytes-base64url

# Optional
UPSTREAM_TIMEOUT_MS=60000
MAX_BODY_MB=4.5
