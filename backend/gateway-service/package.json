{
  "name": "gateway-service",
  "version": "1.0.0",
  "private": true,
  "description": "Single public entry point: JWT check and routing to internal services",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/dev.js",
    "start": "node --env-file=.env src/dev.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src test"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
