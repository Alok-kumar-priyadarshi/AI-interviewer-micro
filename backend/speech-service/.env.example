# speech-service - speech-to-text for spoken answers (local port 4004)
NODE_ENV=development
PORT=4004

GROQ_API_KEY=gsk_replace_me
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_FALLBACK_MODEL=whisper-large-v3
INTERNAL_API_KEY=replace-with-48-random-bytes-base64url

# Optional (Vercel request bodies are capped at 4.5 MB)
MAX_AUDIO_MB=4
