# resume-service - Drive link validation, parsing, profile, RAG index (local port 4002)
NODE_ENV=development
PORT=4002

DATABASE_URL=postgresql://resume_svc:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_MIGRATIONS=postgresql://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Your Groq key (console.groq.com -> API Keys)
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Embeddings for RAG:
#   local = transformers.js on this machine (dev only, downloads ~25 MB model on first use)
#   hf    = Hugging Face Inference free tier (use this on Vercel; needs HF_TOKEN)
#   none  = no embeddings; retrieval uses Postgres full-text search
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Fine-grained token with "Make calls to Inference Providers" (huggingface.co/settings/tokens)
HF_TOKEN=
HF_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction

GUARD_SERVICE_URL=http://localhost:4006
INTERNAL_API_KEY=replace-with-48-random-bytes-base64url

# Optional
MAX_RESUME_MB=5
DRIVE_FETCH_TIMEOUT_MS=10000
