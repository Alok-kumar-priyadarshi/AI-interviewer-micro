# auth-service - signup, login, refresh tokens (local port 4001)
NODE_ENV=development
PORT=4001

# Neon runtime role auth_svc (pooled host). Use the `dev` branch locally, `main` on Vercel.
DATABASE_URL=postgresql://auth_svc:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon OWNER role - only for `npm run db:migrate` on your machine. Never set this on Vercel.
DATABASE_URL_MIGRATIONS=postgresql://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Must equal JWT_ACCESS_SECRET in gateway-service.
JWT_ACCESS_SECRET=replace-with-48-random-bytes-base64url
# Different from the access secret. Used to HMAC refresh tokens before storing them.
JWT_REFRESH_SECRET=replace-with-48-random-bytes-base64url
INTERNAL_API_KEY=replace-with-48-random-bytes-base64url

# Optional
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
